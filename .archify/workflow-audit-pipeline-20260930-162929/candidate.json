  "cards": [
    {
      "dot": "cyan",
      "title": "Scope Contract",
      "items": [
        "Configs bind to an owned, active device \u2014 archived devices reject uploads and audits",
        "Fleet dedup: identical bytes store per device; same device replays idempotently",
        "Every gate is server-enforced, never client-trusted"
      ]
    },
    {
      "dot": "emerald",
      "title": "Live Pipeline",
      "items": [
        "Each engine step commits progress to audit_progress \u2014 visible across processes",
        "Granular steps (validate \u2192 detect \u2192 parse \u2192 normalize \u2192 evaluate \u2192 findings \u2192 report) appear in the sequence and data-flow diagrams",
        "Evaluation updates per file with real percentages"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Ownership",
      "items": [
        "Pipeline failure marks the execution failed; retry creates a fresh row (attempt+1)",
        "Cancellation is cooperative at checkpoints, confirmed as terminal",
        "Lease reaping recovers worker-lost executions"
      ]
    }
  ]
