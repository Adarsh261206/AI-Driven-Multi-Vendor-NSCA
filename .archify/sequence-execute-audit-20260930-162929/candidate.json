      "dot": "cyan",
      "title": "Queue Contract",
      "items": [
        "Execution row is durable before the task is published",
        "Claim is atomic \u2014 duplicate delivery exits safely",
        "Complete is a CAS: cancel that wins first is honored"
      ]
    },
    {
      "dot": "emerald",
      "title": "Live Progress",
      "items": [
        "Worker commits steps to audit_progress (own session, no row lock)",
        "UI polls every 800 ms and renders the running step",
        "Progress survives worker/API process split"
      ]
    },
    {
      "dot": "rose",
      "title": "Scope First",
      "items": [
        "Ownership and lifecycle gates run before any row is created",
        "Non-admin auditors audit only their own devices' configs",
        "Archived devices reject new uploads and audits"
      ]
    }
