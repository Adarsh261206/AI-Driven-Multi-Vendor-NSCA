  "hypotheses": [
    {
      "id": "H08-01",
      "statement": "one Finding concept, four field sets: the section 12 interface, the engine dataclass, the findings table (model + section 19.1 DDL) and the API response disagree - the dataclass has no compliance_result_id but carries audit_id/risk_score/priority/result, the table adds affected_platform, and the four shapes were never reconciled",
      "evidence_tests": [
        "V08-01",
        "V08-05",
        "V08-58"
      ],
      "observed_statuses": [
        "FAIL",
        "FAIL",
        "FAIL"
      ],
      "conclusion": "CONFIRMED",
      "classifications": [
        "DESIGN LIMITATION"
      ]
    },
    {
      "id": "H08-02",
      "statement": "FindingResponse omits control_id (section 12 Finding field 3), so API consumers of either list endpoint cannot see which control a finding came from while the engine record has it",
      "evidence_tests": [
        "V08-02"
      ],
      "observed_statuses": [
        "FAIL"
      ],
      "conclusion": "CONFIRMED",
      "classifications": [
        "BUG"
      ]
    },
    {
      "id": "H08-03",
      "statement": "severity vocabulary drifts from the spec: Severity enum and the persisted findings.severity use lowercase (critical/high/medium/low) where section 12 / DATA_MODEL mandate CRITICAL/HIGH/MEDIUM/LOW, and the API only upper-cases on the way out",
      "evidence_tests": [
        "V08-03",
        "V08-42"
      ],
      "observed_statuses": [
        "FAIL",
        "FAIL"
      ],
      "conclusion": "CONFIRMED",
      "classifications": [
        "BUG",
        "DESIGN LIMITATION"
      ]
    },
    {
      "id": "H08-04",
      "statement": "the evidence attached to findings deviates from section 12: the API types it as Optional[dict] (no chain structure enforced) and the executor-built chain carries result_reasoning instead of reasoning, has no security_control, and leaves raw_config empty - the same drift engine 07 recorded at the chain source (V07-46/47, upstream context only)",
      "evidence_tests": [
        "V08-06",
        "V08-37"
      ],
      "observed_statuses": [
        "FAIL",
        "FAIL"
      ],
      "conclusion": "CONFIRMED",
      "classifications": [
        "DESIGN LIMITATION"
      ]
    },
    {
      "id": "H08-05",
      "statement": "the remediation attached to findings does not carry the section 12 Remediation interface: the executor builds title/description/confidence and never sets finding_id, finding_title or risk_description (executor.py:336-347)",
      "evidence_tests": [
        "V08-09"
      ],
      "observed_statuses": [
        "FAIL"
      ],
      "conclusion": "CONFIRMED",
      "classifications": [
        "DESIGN LIMITATION"
      ]
    },
    {
      "id": "H08-06",
      "statement": "finding status changes are not audited: AuditTrailRepository.log_finding_update (audit_trail.py:142) ships zero callers, so spec 9.1 step 13 'Audit Trail stores complete history' sees nothing when a finding moves to resolved",
      "evidence_tests": [
        "V08-46"
      ],
      "observed_statuses": [
        "FAIL"
      ],
      "conclusion": "CONFIRMED",
      "classifications": [
        "MISSING"
      ]
    },
