# Application
APP_NAME="Network Security Compliance Auditor"
APP_VERSION="1.0.0"
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Database (async driver for asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/compliance_auditor
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379

# AI (optional for MVP - uses MockAIProvider if no key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=10

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".txt", ".cfg", ".conf", ".zip"]

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Audit
AUDIT_FRAMEWORK=CIS
AUDIT_PLATFORM=auto
